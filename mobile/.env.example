# Mobile app config — copy to mobile/.env and populate.
# All EXPO_PUBLIC_* vars are inlined into the JS bundle at build time
# (NOT secret in the cryptographic sense — Firebase API keys are
# protected by Firestore Security Rules, not key obscurity). The reason
# we still externalize them is so staging vs prod configs are easy to
# swap without code changes, and so the repo doesn't bake a specific
# Firebase project ID into source.

EXPO_PUBLIC_API_URL=https://storybook-api-XXXXXXXXX.us-central1.run.app

EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:ios:abcdef0123456789
