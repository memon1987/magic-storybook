# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
STORAGE_BUCKET=your-project-id-storybook-images

# Gemini API Key (store in Secret Manager for production)
GEMINI_API_KEY=your-gemini-api-key

# Server Configuration
PORT=8080
NODE_ENV=development

# FC-017 Phase 4: bearer token Cloud Scheduler uses to call
# POST /api/admin/sweep-orphans. Without this set, the sweep endpoint
# returns 503 (fail-closed). Generate with:
#   openssl rand -base64 48
# Store in Secret Manager and bind to the Cloud Run service:
#   gcloud run services update storybook-api --update-secrets=SWEEP_AUTH_TOKEN=sweep-auth-token:latest
SWEEP_AUTH_TOKEN=
