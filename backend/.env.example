# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
STORAGE_BUCKET=your-project-id-storybook-images

# Gemini API Key (store in Secret Manager for production)
GEMINI_API_KEY=your-gemini-api-key

# Server Configuration
PORT=8080
NODE_ENV=development

# FC-019 spike — character-consistency bakeoff (Gemini Pro vs Flash, both
# text-baked-in). All OFF by default in production. Enable on a dev/staging
# Cloud Run deploy to run POST /api/spike/compare-story/:storyId.
#
# Route-level kill switch (review HIGH-1). When NOT "true", the spike route
# returns 404 BEFORE auth + Firestore reads.
SPIKE_ROUTE_ENABLED=false
#
# Variant B: Gemini 3 Pro Image, text baked in. Uses GEMINI_API_KEY above.
SPIKE_USE_PRO_IMAGE=false
#
# Variant C: Gemini 3.1 Flash Image, text baked in. Uses GEMINI_API_KEY above.
SPIKE_USE_FLASH_BAKED=false
#
# Both variants use a "max consistency" reference strategy: FC-013 character
# model-sheets + an accumulating chain of prior rendered pages, generated
# sequentially. (Recraft was excluded from the bakeoff — Gemini quality won.)
