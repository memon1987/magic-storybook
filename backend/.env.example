# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
STORAGE_BUCKET=your-project-id-storybook-images

# Gemini API Key (store in Secret Manager for production)
GEMINI_API_KEY=your-gemini-api-key

# Server Configuration
PORT=8080
NODE_ENV=development

# FC-019 spike — text-rendering paradigm comparison. All OFF by default in
# production. Enable selectively on a dev/staging Cloud Run deploy to run the
# spike route at POST /api/spike/compare-story/:storyId.
#
# Route-level kill switch (FC-019 review HIGH-1). When this is NOT "true",
# the spike route returns 404 to all callers — even authenticated ones —
# BEFORE auth check or Firestore reads. Belt-and-braces against route
# discovery by anyone with a leaked Firebase token.
SPIKE_ROUTE_ENABLED=false
#
# Variant B: Gemini 3 Pro Image (text baked in). Uses GEMINI_API_KEY above.
SPIKE_USE_PRO_IMAGE=false
#
# Variant C: Recraft V4 (text baked in). Requires RECRAFT_API_KEY from
# https://www.recraft.ai/api signup. Free tier: $5 credits / 30 days.
SPIKE_USE_RECRAFT=false
RECRAFT_API_KEY=
# Override for the Recraft model identifier in case `recraftv4` returns
# HTTP 400 from the Recraft API. Candidates: recraftv4_0, recraft-v4,
# recraftv3 (fallback to V3). See services/recraft.ts comment block.
RECRAFT_MODEL=
